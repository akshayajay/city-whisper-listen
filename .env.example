# The browser uses same-origin /api; no frontend API key is required.
# Optional values for the standalone Node server (npm start):
PORT=8787
HOST=127.0.0.1
DATA_DIR=.data
# Set the external HTTPS origin when running behind an HTTPS reverse proxy:
# PUBLIC_ORIGIN=https://your-deployment.example

# Optional X integration. Keep disabled until API access and budget are approved.
X_ENABLED=false
X_DAILY_POST_LIMIT=0
# Store production secrets in Sites environment settings, never in VITE_* variables.
# X_BEARER_TOKEN=
# X_INGEST_TOKEN=    # Generate a separate random secret of at least 32 characters.
# CITYPULSE_URL=https://citypulse-listen.akshayajayakanth.chatgpt.site
